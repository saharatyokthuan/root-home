# =============================================================================
# /root — home-directory container .gitignore
# =============================================================================
# Keeps system, editor, package-manager, and cache clutter out of the repo.
# Independent projects under projects/ are separate git repos — they are
# ignored here so they are not accidentally staged.

# --- Operating system ---------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Shell / dotfiles (personal environment, not repo content) ----------------
.bash_history
.bash_logout
.bashrc
.profile
.zshrc
.zsh_history
.gitconfig
.git-credentials
.credentials
.aliases.sh
.ssh/
.gpg/
.gnupg/

# --- Editor / IDE -------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
.project
.classpath
.settings/

# --- Package managers & dependencies ------------------------------------------
node_modules/
.bun/
bun.lockb
bun.lock
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.python-version
.pytest_cache/
.tox/
.venv/
venv/
.env

# --- Caches -------------------------------------------------------------------
.cache/
.cache/*
!/.cache/.keep
.npm/
._*

# --- Logs --------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*

# --- OpenCode / assistant state ----------------------------------------------
.opencode/
.superpowers/
.gemini/
.config/opencode/

# --- Personal app data --------------------------------------------------------
.local/
.root/
root
.config/

# --- Cloned project repos -----------------------------------------------------
projects-clone/

# --- Nested project repos (each is its own git repo) -------------------------
projects/*/

# Do not un-ignore specific projects here — already-tracked projects
# (e.g. projects/personal-finance/) remain tracked; new ones stay ignored.
